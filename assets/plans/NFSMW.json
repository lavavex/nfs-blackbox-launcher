   "system_files": [
    {
     "source": "d3dx9_26",
     "to": "syswow64/d3dx9_26.dll",
     "keep_builtin": true
    },
    {
     "source": "d3dx9_43",
     "to": "syswow64/d3dx9_43.dll",
     "keep_builtin": true
    }
   ],
   "texts": [
    {
     "to": "scripts/X360Stuff.ini",
     "body": "# 360 Stuff config\r\n\r\n[VIDEO]\r\n\r\n# Enables custom grass shader. May negatively affect performance\r\nGrassShader = 1\r\n\r\n# Enables parallax scrolling on certain surfaces. Some may prefer this to be off.\r\nDoParallax = 1\r\n\r\n# Uses car's reflection cubemap for rearview mirror.\r\n# Also enables rendering other cars into cubemap\r\nCubemapRVM = 1\r\n\r\n# For performance, Xbox 360 only renders cars into the rear cubemap face\r\n# While slow, this can yield nicer looking results in reflections\r\n# (NOTE: this option is EXPERIMENTAL and may be buggy)\r\nCarsInAllCubemapFaces = 0\r\n\r\n# Enables motion blur. Set to 2 to disable depth masking (may slightly improve performance)\r\nMotionBlur = 0\r\n\r\n# Enables depth of field in NIS cutscenes and certain game moment cameras\r\nDOF = 1\r\n\r\n# Widescreen UI mode\r\n# 0 = Auto-Detect, 1 = Force on, 2 = Force off\r\nWidescreenUIMode = 0\r\n\r\n# Disable this if you're using the original PC Movies (16:9 letterboxed to 4:3)\r\nWidescreenMovies = 1\r\n\r\n# Changes 3D scaling as it varies between various versions\r\n# (and is almost never mathematically correct leading to varying levels of stretching and squashing)\r\n# 0 = Mathematically correct, 1 = Xbox 360, 2 = PC, 3 = PS3, 4 = Original Xbox,\r\n# 5 = GameCube (NTSC), 6 = GameCube (PAL), 7 = PS2 (NTSC), 8 = PS2 (PAL)\r\n# See \"Previews\\Scaling\" for image comparisons\r\nScalingMode = 1\r\n\r\n# Changes 2D/FE scaling as it varies between various versions\r\n# 0 = Custom/Correct scale, 1 = Xbox 360 scale (in widescreen it is equivalent to 0 with 0.92 scale),\r\n# 2 = PC scale, 3 = PS3 scale, 4 = Original Xbox scale, 5 = GameCube (NTSC) scale,\r\n# 6 = GameCube (PAL) scale,  7 = PS2 (NTSC) scale, 8 = PS2 (PAL) scale\r\n# See \"Previews\\Scaling\" for image comparisons\r\nFEScalingMode = 1\r\n\r\n# Sets the scale of the UI when FEScalingMode is 0.\r\n# On Xbox and Xbox 360 in widescreen it is 0.92. On PC and PS2 it is 1.0. On PS3 it is about 0.93 in widescreen.\r\nFEScale = 1.0\r\n\r\n# Various parts of the frontend begin to fall apart as the framerate increases above 60fps.\r\n# Enabling this caps the framerate in the frontend to 60 to avoid the issues.\r\nCapFEFramerate = 1\r\n\r\n# Makes the sunsets no longer engulf the world in shadow,\r\n# hiding the shortcomings of the LiSPSM shadowmapping technique\r\n# PC hid the issues by fading them out instead.\r\nXbox360ShadowAngle = 1\r\n\r\n# Enables the built-in lite widescreen fix (EXPERIMENTAL)\r\nWidescreenFix = 0\r\n\r\n# Sets a custom resolution if widescreen fix isn't present. A value of 0 makes it autodetect the desktop resolution.\r\nXResolution = 0\r\nYResolution = 0\r\n\r\n# Enables the game's built-in unused borderless windowed mode\r\nWindowed = 0\r\n\r\n[ENHANCEMENTS]\r\n\r\n# Xbox 360 doesn't do an actual blur when downscaling for blackbloom, this fixes that\r\nNicerBlackBloom = 1\r\n\r\n# Xbox 360 doesn't do an actual blur when downscaling for DOF, this fixes that\r\nNicerDOF = 1\r\n\r\n# Xbox 360 uses a depth sorting algorithm for trees, though that doesn't always yield the best results. This forces the use of fixed rendering order values.\r\nFixedTreeRenderOrder = 1\r\n\r\n# Xbox 360 uses lowlod shader for traffic and cop cars in the main view. Enable this to use full LOD shader instead.\r\nUseFullLODShaderOnTrafficAndCops = 0\r\n\r\n# Xbox 360 sets twkTimeOfDayOvercast in NISes, but rarely ever sets it back properly, causing the weather cycle to freeze until it does\r\n# Enabling this makes the override get reset the next time you return to FE.\r\n# It also nerfs Earl's Earth-rotating powers.\r\nResetOvercastOverrideAfterNIS = 1\r\n\r\n# The Xbox 360 version limits the render distance of cubemaps (except for the rear face as it's used for RVM) to 100m. \r\n# You can extend it by setting this to a higher value\r\n# 100.0 = Xbox 360, 15000.0 = PC (same as main view, slightly overkill), 300.0 = ProStreet\r\nEnvMapFarPlane = 100.0\r\n\r\n# Same as above but for the rear face and RVM. Due to it being used for the mirror it has a bigger distance.\r\n# 400.0 = Xbox 360 (both MW and ProStreet), 15000.0 = PC (same as main view)\r\nMirrorFarPlane = 400.0\r\n\r\n# On the 360 version they tried to fix stretching at screen edges during intense motion blur by reversing its direction,\r\n# but they only did it on the Z axis making it appear incorrect diagonally. This fixes that. You can also set it to 2\r\n# to remove the fix altogether and make it more like Carbon where they also did that.\r\nFixDiagonalMotionBlur = 1\r\n\r\n[MISC]\r\n\r\n# Makes game take screenshots in PNG format instead of TGA\r\nTakePNGScreenshots = 1\r\n\r\n# Changes path that screenshots are saved to.\r\n# Example path: %UserProfile%\\Documents\\NFS Most Wanted\r\n# Defaults to My Pictures folder if path is blank or doesn't exist.\r\nPNGScreenshotPath = %UserProfile%\\Documents\\NFS Most Wanted\r\n\r\n# Sets car lighting (Shaper Light Rig) setup\r\n# 0: Xbox 360\r\n# 1: OPM\r\n# 2: E3-style\r\n# 3: vanilla PC/unmodified (use this if another mod modifies shaper lights)\r\nCarShaperLightType = 0\r\n\r\n# Allows cars to self-shadow (NOT how it's intended by devs so don't expect it to look good)\r\nCarSelfShadow = 0\r\n\r\n# Enables controller tips screen (VERY broken right now)\r\nEnableLoadingControllerScreen = 0\r\n\r\n# Controller tips texture name (_C1 suffix for analog steer, _C2 for dpad steer)\r\nLoadingControllerScreenTextureName = LOADING_CONTROLLER_X360_C1\r\n\r\n# Controls the sensitivity of the motion blur to speed\r\n# Default value is 1.0\r\nDirectionalMotionBlurStrength = 1.0\r\n\r\n# Xbox 360 has unused angular motion blur, nullified by its strength constant being set to 0\r\n# A recommended value to reenable it would be around 500\r\n# Default value is 0.0\r\nAngularMotionBlurStrength = 0.0\r\n\r\n# Allows you to change the minimum shadow projection height\r\n# 0.7 = Xbox 360, 1.0 = nearly straight down, 0.0 = can go down to horizon\r\n# NOTE: this value is approximate as it only changes the Z component of the sun direction vector\r\n# and doesn't change lighting or the sun position itself, only shadowcasting.\r\n# It's not recommended to change this value if you value accuracy.\r\nMinimumShadowAngleHeight = 0.7\r\n\r\n# Fixes time of day changes done by NISes on the 360 version.\r\n# Disabling this restores broken PC behavior.\r\nNISTimeOfDayEvent = 1\r\n\r\n# Enables the use of the current-gen/PC sun flare instead.\r\n# Only enable this if you like the bigger flare on those versions, or need compatibility with existing sun flare mods.\r\nCurrentGenSunFlare = 0\r\n\r\n# The retail Xbox 360 version uses the black bloom curve for both black bloom AND color bloom.\r\n# Enabling this restores what seems to have been early behavior, and what is the retail PC behavior.\r\n# Use this with visual treatment presets tuned for PC visual treatment.\r\nUseColourBloomCurve = 0\r\n\r\n# This value affects the brightness of exposure adaptation. It is not recommended to be changed from the Xbox 360 default of 0.14.\r\n# Set this to 0.19 for (roughly) PC-equivalent brightness, which is best paired with the option above.\r\n# NOTE: NISes have the ability to override this value. So far a NIS that does this hasn't been observed, but the capability is there.\r\nMiddleGrayValue = 0.14\r\n\r\n# Set this to a value greater than zero to force a constant luminance level. May offer a very slight speedup.\r\n# Setting this to 1.0 and MiddleGrayValue to 0.62 should offer roughly the same constant luminance as PC.\r\nForcedLuminance = 0.0\r\n"
    }
   ],
