 "texts": [
  {
   "to": "dxvk.conf",
   "body": "# NFS Most Wanted — DXVK 3.1.1\n# The 360 pack rewrites dynamic buffers the GPU may still be reading; cached\n# CPU-side copies keep those locks from waiting on the GPU.\nd3d9.cachedDynamicBuffers = True\n"
  },
  {
   "to": "alsoft.ini",
   "body": "\n# prospero-win: the PS5 port takes 48 kHz stereo; a deeper buffer than the default 3 x 1024 for the console's coarser thread wake-ups.\n[general]\nchannels = stereo\nfrequency = 48000\nperiod_size = 1024\nperiods = 4\nhrtf = false\n",
   "append": true
  }
 ],
